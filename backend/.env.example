# ═══════════════════════════════════════════════
# NEO-TERRA BACKEND — Variables de Entorno
# Copiar este archivo como .env y rellenar valores
# ═══════════════════════════════════════════════

# ── SERVIDOR ────────────────────────────────────
PORT=3001

# ── SUPABASE ────────────────────────────────────
# Obtener en: https://supabase.com → Settings → API
SUPABASE_URL=https://TU-PROYECTO-ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── CORS / FRONTEND ─────────────────────────────
# URL del frontend (Vercel en producción)
FRONTEND_URL=http://localhost:3000

# ── SEGURIDAD ────────────────────────────────────
# Secreto aleatorio largo (mínimo 32 caracteres)
GAME_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-2045

# ── MODO ─────────────────────────────────────────
NODE_ENV=development
